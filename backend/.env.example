# Free-tier friendly image generation provider.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-workers-ai-token
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_PROMPT_MODEL=@cf/meta/llama-3.1-8b-instruct
ENABLE_AI_PROMPT_ENHANCER=true
CLOUDFLARE_TIMEOUT_MS=30000

# Optional paid fallback provider.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_TIMEOUT_MS=90000

# VNPay Payment Gateway
# Get test credentials at https://sandbox.vnpayment.vn
VNP_TMN_CODE=your-merchant-code
VNP_HASH_SECRET=your-hash-secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:3000/api/payment/vnpay-return

# SQL Server (SSMS / SQL Server Express or Default Instance)
# Leave SQL_USER and SQL_PASSWORD empty to use Windows Authentication
# SQL_SERVER=localhost           (or localhost\SQLEXPRESS for named instance)
# SQL_PORT=1433                 (default, ignored for named instances)
# SQL_DATABASE=BlankupDB        (auto-created if missing)
# SQL_USER=sa                   (omit for Windows Auth)
# SQL_PASSWORD=your-password    (omit for Windows Auth)
# REQUIRE_SQL_SERVER=true       (exit on DB failure instead of demo mode)

# JWT (access token signing)
JWT_SECRET=change-me-in-production

# Google OAuth (Login with Google)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Gmail SMTP (Email Verification, Forgot/Reset Password)
# Use Gmail App Password (not account password): https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cubinlylom@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Blankup <cubinlylom@gmail.com>"

# CORS — Comma-separated list of allowed frontend origins
# REQUIRED in production. Example: https://blankup.vn,https://www.blankup.vn
# In development, localhost origins are allowed by default.
ALLOWED_ORIGINS=

# Password Reset token validity (minutes)
RESET_TOKEN_EXPIRY_MINUTES=60
